# Project scm-tower - Environment Configuration Template
# Use this template to set up environment variables before production deployment.
# Only fill in the values that are specific to your production environment.

# OpenRouter API Key (for fallback when 9router is unavailable)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Supabase credentials
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_NAMESPACE=your-namespace-name
SUPABASE_PRIVATE_KEY=your-supabase-private-key-here

# Application settings
NODE_ENV=development
PORT=3000

# Optional: Feature flags
ENABLE_MIGRATION_SCHEMA_CHECK=true
ENABLE_SECURITY_AUDIT=true

# Logging
LOG_LEVEL=info
