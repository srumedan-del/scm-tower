# Salin menjadi .env lalu isi dengan akun SIRUP Anda sendiri. File .env tidak ikut ke Git.
SIRUP_USERNAME=
SIRUP_PASSWORD=
# Opsional, bawaan sudah benar untuk SRU Medan:
# SIRUP_BASE_URL=https://datawh.sinarrodautama.co.id/sirup
# SIRUP_STOCK_PATH=/reportnav/stokgudang?idm=379&idm_enc=cFJ6NS9VWGU0SHhxWTRXdHdJMm1jUT09

# Role dan client yang dipilih setelah login (halaman "Masukkan role dan client anda").
# 407 = SCM Medan, 1 = Sinar Roda Utama. Kosongkan untuk memakai nilai ini.
SIRUP_ROLE=407
SIRUP_CLIENT=1

# Data stok: seluruh lokasi cabang Medan, tanpa saring kategori.
# SIRUP_CABANG=CAB01-MDN
# SIRUP_LOCCODE=All
# Arsip CSV lengkap di PC ini, dan berapa hari baris lengkap disimpan di Supabase.
# SIRUP_LOCAL_DIR=D:/SIRUP-Stok
# SIRUP_KEEP_DAYS=30
