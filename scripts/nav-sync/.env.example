# Salin menjadi .env lalu isi dengan akun NAV Anda sendiri. File .env tidak ikut ke Git.
NAV_USERNAME=
NAV_PASSWORD=

# Opsional, bawaan sudah sesuai untuk SRU Medan:
# NAV_BASE_URL=http://10.10.20.166:8080/dynamicsnav110/WebClient/
# NAV_COMPANY=PT. SINAR RODA UTAMA
# Berapa hari ke belakang yang diambil setiap kali jalan (data yang sudah ada tetap dilewati).
# NAV_DAYS=7
# Folder arsip file Excel dari NAV (satu folder per hari).
# NAV_ARCHIVE_DIR=D:/nav
# Nomor halaman NAV bila berbeda:
# NAV_PAGE_PSS=142
# NAV_PAGE_PTR=5753
# NAV_PAGE_ILE=38
# Lokasi gudang yang diambil (PSS & ILE: Location Code, PTR: Transfer-to Code).
# NAV_LOCATION=MDN-PAR
